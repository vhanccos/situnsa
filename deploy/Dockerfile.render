# ---------- Stage 1: Builder ----------
FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app
COPY pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile
RUN pnpm build

# ---------- Stage 2: Runner Render (Nginx + Node API + SPA) ----------
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

# Instalar Nginx
RUN apk add --no-cache nginx

# Copiar artefactos de la app compilada y dependencias
COPY pnpm-workspace.yaml package.json turbo.json ./
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/db/drizzle ./packages/db/drizzle

# Copiar build de la SPA a Nginx
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Configuración Nginx y Entrypoint
COPY deploy/nginx.render.conf /etc/nginx/nginx.render.conf
COPY deploy/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Directorio para subida de PDFs / almacenamiento local
RUN mkdir -p /var/data/titulacion-docs

EXPOSE 10000

CMD ["/app/entrypoint.sh"]
