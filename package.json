{
  "name": "pis-titulacion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d postgres mailpit && turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --workspace=vitest.workspace.ts",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prod:local": "docker compose -f deploy/docker-compose.prod.yml up --build",
    "prod:down": "docker compose -f deploy/docker-compose.prod.yml down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
